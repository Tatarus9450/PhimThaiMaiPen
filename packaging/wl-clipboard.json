{
  "name": "wl-clipboard",
  "buildsystem": "meson",
  "config-opts": [
    "-Dzshcompletiondir=no",
    "-Dfishcompletiondir=no"
  ],
  "cleanup": [
    "/share/bash-completion",
    "/share/zsh",
    "/share/fish",
    "/share/man"
  ],
  "post-install": [
    "install -Dm644 COPYING /app/share/licenses/wl-clipboard/COPYING"
  ],
  "sources": [
    {
      "type": "archive",
      "url": "https://github.com/bugaevc/wl-clipboard/archive/refs/tags/v2.2.1.tar.gz",
      "sha256": "6eb8081207fb5581d1d82c4bcd9587205a31a3d47bea3ebeb7f41aa1143783eb"
    }
  ]
}
