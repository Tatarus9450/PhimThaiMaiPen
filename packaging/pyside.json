{
  "name": "pyside",
  "modules": [
    {
      "name": "patchelf-pyside-build",
      "buildsystem": "autotools",
      "cleanup": ["*"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/NixOS/patchelf/releases/download/0.18.0/patchelf-0.18.0.tar.bz2",
          "sha256": "1952b2a782ba576279c211ee942e341748fdb44997f704dd53def46cd055470b"
        }
      ]
    }
  ],
  "buildsystem": "cmake-ninja",
  "builddir": true,
  "build-options": {
    "env": {
      "PYTHONPATH": "/run/build/pyside/_flatpak_build/sources"
    },
    "append-path": "/usr/lib/sdk/llvm21/bin",
    "append-ld-library-path": "/usr/lib/sdk/llvm21/lib"
  },
  "config-opts": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DBUILD_TESTS=OFF",
    "-DFORCE_LIMITED_API=OFF",
    "-DSHIBOKEN_FORCE_PROCESS_SYSTEM_INCLUDE_PATHS=/usr/include",
    "-DMODULES=Core;Gui;Widgets;Network;DBus;Multimedia",
    "-DNO_QT_TOOLS=yes"
  ],
  "sources": [
    {
      "type": "archive",
      "url": "https://download.qt.io/official_releases/QtForPython/pyside6/PySide6-6.11.1-src/pyside-setup-everywhere-src-6.11.1.tar.xz",
      "sha256": "6ffd9835bb0dd2c56f061d62f1616bb1707cfc0202b80e3165d6be087f3965e2"
    },
    {
      "type": "patch",
      "paths": [
        "patches/pyside-fix-header-installation-path.patch",
        "patches/pyside-fix-header-packaging.patch"
      ]
    },
    {
      "type": "file",
      "path": "pyside-dist-info.py"
    },
    {
      "type": "file",
      "path": "pyside-relocate.py"
    }
  ],
  "post-install": [
    "python3 /run/build/pyside/pyside-relocate.py --prefix /app",
    "python3 /run/build/pyside/pyside-dist-info.py --source-root /run/build/pyside --build-root /run/build/pyside/_flatpak_build --prefix /app"
  ],
  "cleanup": [
    "/bin",
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/lib/plugins/designer",
    "/lib/debug/bin",
    "/lib/debug/lib/plugins/designer",
    "/share/PySide6/glue",
    "/share/PySide6/doc"
  ]
}
